# Caddyfile-mobile - MyeCommerce POS
# HTTPS en :8443 para telefono (camara como lector de barras)
# Uso: caddy.exe run --config Caddyfile-mobile
#
# Si "admin off" falla, eliminar el bloque global y dejar solo :8443

{
	admin off
}

:8443 {
	tls internal
	reverse_proxy localhost:3000
	header {
		Cross-Origin-Embedder-Policy "credentialless"
		Cross-Origin-Opener-Policy "same-origin"
		Cache-Control "public, max-age=3600"
		X-Content-Type-Options "nosniff"
		Upgrade "websocket"
		Connection "upgrade"
	}
	log {
		output file caddy-mobile.log
		format json
		level INFO
	}
}
