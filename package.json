{
  "name": "my-ecommerce",
  "version": "2.9.63",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cf": "npx wrangler pages dev .vercel/output/static --compatibility-date=2024-11-01 --binding DB=myecommerce-ferreteria-central",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev .vercel/output/static",
    "deploy:pos": "npx @cloudflare/next-on-pages && npx wrangler pages deploy .vercel/output/static --project-name=myecommerce-pos",
    "lint": "tsc --noEmit 2>&1 | head -60",
    "setup:local": "npx prisma db push",
    "setup:d1": "npx wrangler d1 execute myecommerce-ferreteria-central --remote --file=./prisma/schema.sql"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "canvg": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.4",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jose": "^5.9.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "2.5.2",
    "jspdf-autotable": "3.8.4",
    "lucide-react": "^0.460.0",
    "next": "15.3.3",
    "next-themes": "^0.4.4",
    "pagedjs": "^0.4.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "wrangler": "^3.90.0"
  }
}
