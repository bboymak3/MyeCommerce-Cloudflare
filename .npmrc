# Optimización para instalación rápida en Windows
prefer-offline=true
audit=false
fund=false
progress=true
loglevel=warn
# omit=optional se quito: en el build de Cloudflare (Linux) omitia binarios que Next.js necesita
ignore-scripts=false
# Tolera el conflicto de peer deps entre wrangler 4.x y @cloudflare/next-on-pages
legacy-peer-deps=true
# Cloudflare Pages define NODE_ENV=production (desde wrangler.toml) durante la instalacion;
# sin esto npm omite devDependencies (prisma, next-on-pages, tailwind...) y el build falla.
include=dev
